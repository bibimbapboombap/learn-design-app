# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.

# --- Auth (required) ---
# Random secret that signs session cookies. Generate one with: npx auth secret
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Who may sign in (optional) ---
# Comma-separated. Leave both empty to let any Google account in.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# --- Admins (optional) ---
# Who can open /admin. Comma-separated. Defaults to NOTIFY_EMAIL.
ADMIN_EMAILS=

# --- Task list from Notion (optional locally; without it a sample list is shown) ---
# Internal integration secret (notion.so/profile/integrations). Share the page
# with the integration: page ··· menu → Connections.
NOTION_TOKEN=
# The page's URL or id.
NOTION_PAGE_ID=

# --- Completion emails (optional locally; without them the email is logged) ---
RESEND_API_KEY=
# Where notifications go. Comma-separated for several recipients.
NOTIFY_EMAIL=vadim.grin@gmail.com
# Sender. onboarding@resend.dev works without a verified domain, but can only
# deliver to the email address the Resend account was created with. To reach
# several recipients, verify vadimgrin.com in Resend and use an address on it.
EMAIL_FROM="Design Learning <onboarding@resend.dev>"

# --- Database (optional locally; required in production) ---
# Postgres connection string (Neon). Without it, progress is saved to
# .data/progress.json.
DATABASE_URL=
