# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.

# --- Auth (required) ---
# Random secret that signs session cookies. Generate one with: npx auth secret
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Who may sign in (optional) ---
# Comma-separated. Leave both empty to let any Google account in.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# --- Completion emails (optional locally; without them the email is logged) ---
RESEND_API_KEY=
# Where notifications go. Comma-separated for several recipients.
NOTIFY_EMAIL=
# Sender. onboarding@resend.dev works without a verified domain, but can only
# deliver to the email address you signed up to Resend with.
EMAIL_FROM="Learn Design <onboarding@resend.dev>"

# --- Database (optional locally; required in production) ---
# Postgres connection string (Neon). Without it, progress is saved to
# .data/progress.json.
DATABASE_URL=
